---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { hasOutline } from '../../lib/toc';
import NewsletterCallout from '../../components/NewsletterCallout.astro';
import {
  formatDate,
  getPosts,
  inlineMarkdown,
  plainText,
  postUrl,
  type Post,
} from '../../lib/posts';
import '../../styles/prose.css';
import '../../styles/code.css';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts[] is newest-first: the *next* index is the older post.
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
};

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, categories, image, math, draft } = post.data;
const { Content, headings } = await render(post);
/* Whether this post gets a sidebar outline — drives both the two-track grid
   and whether the scroll-spy script ships at all. */
const showToc = hasOutline(headings);
/* Inline scroll-spy for the sidebar outline — see the note where it is
   rendered. Kept as a string so Astro emits it verbatim, and stripped of its
   newlines on the way out. A rAF-throttled scroll listener rather than a bare
   IntersectionObserver: an observer only reports *changes* in intersection, so
   a jump — an in-page anchor, a restored scroll position, a fast flick — can
   move several headings past the trigger band without firing at all. */
const scrollSpy = `(function(){
var t=document.querySelector('.post-shell>.toc--sidebar');
if(!t)return;
var m={},s=[];
Array.prototype.forEach.call(t.querySelectorAll('a[href^="#"]'),function(a){
var e=document.getElementById(decodeURIComponent(a.hash.slice(1)));
if(e){m[e.id]=a;s.push(e)}});
if(!s.length)return;
var cur=null,queued=false;
function u(){queued=false;
var hit=null,line=window.innerHeight*0.28,i;
for(i=0;i<s.length;i++){if(s[i].getBoundingClientRect().top<=line)hit=s[i]}
var a=hit?m[hit.id]:null;
if(a===cur)return;
if(cur)cur.removeAttribute('aria-current');
cur=a;
if(a)a.setAttribute('aria-current','true')}
function q(){if(queued)return;queued=true;requestAnimationFrame(u)}
addEventListener('scroll',q,{passive:true});
addEventListener('resize',q);
addEventListener('hashchange',q);
u()})();`.replace(/\n/g, '');

---

<Base
  title={title}
  description={description && plainText(description)}
  image={image?.src}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  math={math}
  noindex={draft}
>
  {/* `dense`: post pages read one step below the landing page — see the
      density block in global.css. */}
  <div class="wrap dense">
    <div class:list={['post-shell', showToc && 'post-shell--toc']}>
      {/* The outline sits to the *left* of the article on wide screens, its
          text right-aligned so it hugs the article's left edge. It comes first
          in the DOM so the visual and reading orders agree. */}
      <TableOfContents headings={headings} variant="sidebar" />

      {/* The header and the collapsible contents are page furniture, not
          running text, so they sit *outside* `.prose`: inside it they picked up
          markdown list styling (the indent and between-item leading that threw
          the category pills out of alignment). `.prose` now wraps only the
          rendered markdown. */}
      <article class="post-article">
        <header class="post-header">
          <h1 class="post-header__title">{title}</h1>
          <div class="post-header__meta">
            <span class="post-header__dateline">
              <time datetime={date.toISOString()}>{formatDate(date)}</time>
              {updated && (
                <Fragment>
                  {' · '}Updated{' '}
                  <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                </Fragment>
              )}
              {draft && <Fragment>{' · '}<span style="color:var(--accent)">Draft</span></Fragment>}
            </span>
            <CategoryPills categories={categories} />
          </div>
          {
            description && (
              <p class="post-header__description" set:html={inlineMarkdown(description)} />
            )
          }
        </header>

        <TableOfContents headings={headings} variant="mobile" />

        <div class="prose">
          <Content />
        </div>
      </article>
    </div>

    <div class="prose-width" style="margin-top:var(--space-xl)">
      <NewsletterCallout />
    </div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a class="post-nav__item post-nav__prev" href={postUrl(older)}>
              <span class="post-nav__dir">← Previous</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post-nav__item post-nav__next" href={postUrl(newer)}>
              <span class="post-nav__dir">Next →</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
  {
    /* ── Scroll-spy (the site's one deliberate exception to zero client JS) ──
       Highlights the outline entry for the section in view. Progressive
       enhancement: the outline works fully without it, and it ships only on
       post pages that actually render a sidebar outline. Smooth scrolling is
       CSS (`scroll-behavior`), already switched off under
       prefers-reduced-motion, so there is no motion to gate here. */
    showToc && <script is:inline set:html={scrollSpy} />
  }
</Base>
