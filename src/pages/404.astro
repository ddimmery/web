---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <div class="wrap">
    <div class="centered-note">
      <p class="eyebrow">Error 404</p>
      <h1 style="margin-block:0.4em 0.6em">This page isn't here</h1>
      <p>
        The link may be old, or I may have moved something. Try the <a href="/blog/">blog</a>,
        the <a href="/research/">research</a> list, or start from the <a href="/">homepage</a>.
      </p>
    </div>
  </div>
</Base>
