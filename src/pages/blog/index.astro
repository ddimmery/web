---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterCallout from '../../components/NewsletterCallout.astro';
import { categoriesOf, getPosts } from '../../lib/posts';

const posts = await getPosts();
const categories = categoriesOf(posts);
---

<Base
  title="Blog"
  description="Writing by Drew Dimmery on causal inference, experimentation, technology and the web."
>
  <div class="wrap wrap--column">
    <h1 class="page-title">Blog</h1>

    <div class="prose-width" style="margin-bottom:var(--space-l)">
      <NewsletterCallout />
    </div>

    {
      categories.length > 0 && (
        <nav aria-label="Categories" style="margin-bottom:var(--space-l)">
          <p class="eyebrow" style="margin-bottom:0.5rem">Browse by category</p>
          <ul class="pills">
            {categories.map((category) => (
              <li>
                <a class="pill" href={`/blog/category/${category.slug}/`}>
                  {category.name} ({category.count})
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post, index) => (
            <li>
              <PostCard post={post} eager={index === 0} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
