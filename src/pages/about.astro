---
import Base from '../layouts/Base.astro';

const interests = [
  'Causal Inference',
  'Machine Learning',
  'Data Science',
  'Experimental Design',
];

interface Entry {
  title: string;
  meta: string[];
  role?: string;
  sub?: string[];
  /** May contain inline HTML (links, emphasis). */
  notes?: string[];
}

const experience: Entry[] = [
  {
    title: 'Hertie School',
    meta: ['January 2024 – present'],
    role: 'Professor of Data Science for the Common Good',
  },
  {
    title: 'University of Vienna',
    meta: ['April 2021 – December 2023'],
    role: 'Scientific Coordinator',
    notes: ['Supervisor: Philipp Grohs / Torsten Möller'],
  },
  {
    title: 'Facebook Core Data Science',
    meta: ['Sept 2016 – March 2021'],
    role: 'Research Scientist',
    notes: [
      "Part of Eytan Bakshy's Adaptive Experimentation team",
      'Developed statistical, machine learning and experimental methodology',
      'Ran adaptive and contextual field experiments with a variety of product teams',
      'Integrated advanced methodologies into a toolkit for scalable and automatic experimentation intended for optimization (<a href="https://ax.dev/">Ax</a>) — <a href="https://developers.facebook.com/videos/2019/product-optimization-with-adaptive-experimentation/">released at F8 2019</a>',
      'Developed scalable methods for robust observational causal inference as the technical lead of our "CausalML" initiative',
    ],
  },
  {
    title: 'Princeton University',
    meta: ['September 2015 – May 2016'],
    role: 'Pre-doctoral fellow',
    notes: ['Supervised by Kosuke Imai'],
  },
  {
    title: 'Facebook Core Data Science',
    meta: ['Summer 2015'],
    role: 'Summer Intern',
    notes: ['Statistical and Decision Science Team', 'Supervised by Eytan Bakshy'],
  },
];

const education: Entry[] = [
  {
    title: 'New York University',
    sub: ['PhD in Political Methodology', 'Advisors: Cyrus Samii, Neal Beck, Josh Tucker'],
    meta: ['New York, NY', 'Granted May 2016'],
    notes: [
      'Dissertation: <em>Essays on Causal Inference and Machine Learning with Application to Nonprofits</em>',
      'Winner of the 2015 Williams Award for Best Dissertation Proposal in Political Methodology from the Society of Political Methodology',
    ],
  },
  {
    title: 'UNC Chapel Hill',
    sub: ['B.A. in International and Area Studies with distinction'],
    meta: ['Chapel Hill, NC', 'Granted June 2010'],
  },
];

const teaching: Array<{ institution: string; courses: Array<[string, string]> }> = [
  {
    institution: 'Hertie School',
    courses: [
      ['Causal Machine Learning', '2024–'],
      ['Data Structures & Algorithms', '2024–'],
      ['Machine Learning', '2024–'],
    ],
  },
  {
    institution: 'Facebook',
    courses: [
      ['Internal datacamp class on designing and analyzing experiments', '2017–2019'],
    ],
  },
  {
    institution: 'NYU Undergraduate',
    courses: [
      ['TA for Power and Politics in America (under Jonathan Nagler)', 'Fall 2014'],
      ['TA for Games, Strategy and Politics (under Steven Brams)', 'Fall 2013'],
    ],
  },
  {
    institution: 'NYU Graduate',
    courses: [
      ['TA for Quantitative Methods II (under Nathaniel Beck)', 'Spring 2015'],
      ['TA for Quantitative Methods II (under Cyrus Samii)', 'Spring 2014'],
      ['High Performance Computing Talk for NYU Datalab', 'February 2014'],
      ['Introduction to R for NYU Datalab', 'January 2013'],
    ],
  },
];
---

<Base
  title="About"
  description="Drew Dimmery — professor of data science, previously Facebook Core Data Science and the University of Vienna."
>
  <div class="wrap wrap--column">
    <h1 class="page-title">About</h1>

    <div class="prose-width">
      <p class="lede">
        I am the <a
          href="https://www.hertie-school.org/en/research/faculty-and-researchers/profile/person/dimmery"
          >Professor of Data Science for the Common Good</a
        > at the <a href="https://www.hertie-school.org/en/">Hertie School</a>'s <a
          href="https://www.hertie-school.org/en/datasciencelab">Data Science Lab</a
        >.
      </p>
    </div>

    <section class="section">
      <div class="rule-heading"><h2 class="eyebrow">Research interests</h2></div>
      <ul class="tag-list">
        {interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="rule-heading"><h2 class="eyebrow">Experience</h2></div>
      {
        experience.map((entry) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <span class="cv-entry__title">{entry.title}</span>
              <span class="cv-entry__meta">{entry.meta.join(' · ')}</span>
            </div>
            {entry.role && <p class="cv-entry__role">{entry.role}</p>}
            {entry.notes && (
              <ul class="cv-entry__notes">
                {entry.notes.map((note) => (
                  <li set:html={note} />
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="section">
      <div class="rule-heading"><h2 class="eyebrow">Education</h2></div>
      {
        education.map((entry) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <span class="cv-entry__title">{entry.title}</span>
              <span class="cv-entry__meta">
                {entry.meta.map((line, index) => (
                  <Fragment>
                    {index > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </span>
            </div>
            {entry.sub && (
              <p class="cv-entry__role">
                {entry.sub.map((line, index) => (
                  <Fragment>
                    {index > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </p>
            )}
            {entry.notes && (
              <ul class="cv-entry__notes">
                {entry.notes.map((note) => (
                  <li set:html={note} />
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="section">
      <div class="rule-heading"><h2 class="eyebrow">Teaching</h2></div>
      {
        teaching.map((group) => (
          <div class="cv-entry">
            <h3 class="cv-entry__title" style="margin-bottom:0.35rem">
              {group.institution}
            </h3>
            {group.courses.map(([course, when]) => (
              <div class="cv-line">
                <span>{course}</span>
                <span class="cv-line__meta">{when}</span>
              </div>
            ))}
          </div>
        ))
      }
    </section>
  </div>
</Base>
