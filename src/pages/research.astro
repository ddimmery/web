---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LinkButton from '../components/LinkButton.astro';
import {
  authorSegments,
  bestUrl,
  groupByYear,
  isPublished,
  type PaperData,
} from '../lib/papers';

const entries = await getCollection('papers', ({ data }) => data.visible);
const papers = entries.map((entry) => entry.data);

const published = groupByYear(papers.filter(isPublished));
const working = groupByYear(papers.filter((paper) => !isPublished(paper)));

function buttons(paper: PaperData) {
  const list: Array<{ href: string; icon: 'pdf' | 'github' | 'database' | 'archive'; label: string }> =
    [];
  if (paper.preprint) list.push({ href: paper.preprint, icon: 'pdf', label: 'Preprint' });
  if (paper.github) list.push({ href: paper.github, icon: 'github', label: 'Github' });
  if (paper.data) list.push({ href: paper.data, icon: 'database', label: 'Data' });
  if (paper.pdf_url) list.push({ href: paper.pdf_url, icon: 'pdf', label: 'PDF' });
  if (paper.published_url)
    list.push({ href: paper.published_url, icon: 'archive', label: 'Published' });
  return list;
}
---

<Base
  title="Research"
  description="Publications and working papers by Drew Dimmery on causal inference, machine learning and experimental design."
>
  <div class="wrap wrap--column">
    <h1 class="page-title">Research</h1>

    {
      [
        { id: 'published', heading: 'Published', groups: published },
        { id: 'working-papers', heading: 'Working Papers / Non-archival', groups: working },
      ].map((section) =>
        section.groups.length === 0 ? null : (
          <section class="section" id={section.id} style="margin-top:var(--space-l)">
            <div class="rule-heading">
              <h2 class="eyebrow">{section.heading}</h2>
            </div>
            {section.groups.map((group) => (
              <div class="year-group">
                <h3 class="year-group__heading" id={`${section.id}-${group.year}`}>
                  {group.year}
                </h3>
                <ul class="paper-list">
                  {group.papers.map((paper) => {
                    const url = bestUrl(paper);
                    return (
                      <li>
                        <h4 class="paper__title">
                          {url ? (
                            <a href={url} rel="noopener noreferrer">
                              {paper.title}
                            </a>
                          ) : (
                            paper.title
                          )}
                        </h4>
                        <p class="paper__meta">
                          {authorSegments(paper.authors).map((part) =>
                            part.me ? <strong>{part.text}</strong> : part.text,
                          )}
                          {' ('}
                          {group.year}
                          {')'}
                          {paper.venue && (
                            <Fragment>
                              {' · '}
                              <span class="paper__venue">{paper.venue}</span>
                            </Fragment>
                          )}
                        </p>
                        {buttons(paper).length > 0 && (
                          <div class="btn-row">
                            {buttons(paper).map((button) => (
                              <LinkButton
                                href={button.href}
                                icon={button.icon}
                                label={button.label}
                              />
                            ))}
                          </div>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </section>
        ),
      )
    }
  </div>
</Base>
