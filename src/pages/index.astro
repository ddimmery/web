---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';
import { yearOf } from '../lib/papers';
import { site } from '../lib/site';

/* ── HOME LAYOUT VARIANT ────────────────────────────────────────────────────
   Three interchangeable layouts live in `src/design-variants/` (outside
   `src/pages/`, so they create no routes). Swap the import below to change the
   home page; every variant takes the same props.

     HomeVariantA — refined current: bio left, large portrait right,
                    two-column recents below a hairline.
     HomeVariantB — editorial: full-width name banner, portrait in a wide
                    masthead row, recents as one wide ruled list.
     HomeVariantC — side-rail identity: sticky portrait/name/socials rail on
                    the left, content flowing to its right. ← active
   ───────────────────────────────────────────────────────────────────────── */
import Home from '../design-variants/HomeVariantC.astro';

const posts = (await getPosts()).slice(0, 5);

const papers = (await getCollection('papers', ({ data }) => data.visible))
  .map((entry) => entry.data)
  .filter((paper) => Boolean(paper.published_url))
  .sort((a, b) => Number(yearOf(b)) - Number(yearOf(a)))
  .slice(0, 4);
---

<Base title={site.title} description={site.description}>
  <Home posts={posts} papers={papers} />
</Base>
