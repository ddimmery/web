---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';
import { yearOf } from '../lib/papers';
import { site } from '../lib/site';

/* ── HOME LAYOUT VARIANT ────────────────────────────────────────────────────
   Six interchangeable layouts live in `src/design-variants/` (outside
   `src/pages/`, so they create no routes). Swap the import below to change the
   home page; every variant takes the same props (see `home-props.ts`) and
   imports its own stylesheet, so the inactive ones ship no CSS.

     HomeVariantA — refined current: bio left, large portrait right,
                    two-column recents below a hairline.
     HomeVariantB — editorial: full-width name banner, portrait in a wide
                    masthead row, recents as one wide ruled list.
     HomeVariantC — side-rail identity: sticky rail on the left carrying the
                    portrait, name, tagline and socials; the biography and the
                    two recents feeds flow to its right. ← active
     HomeVariantD — full-bleed portrait rail: C pushed harder. The rail is a
                    tinted panel running from the window edge to the footer,
                    with the portrait bleeding across its full width.
     HomeVariantE — typographic index: huge stacked "DREW / DIMMERY" masthead,
                    one small portrait, recents as numbered wall-to-wall
                    indexes with the date or venue on the right edge.
     HomeVariantF — letterhead: centered identity block with a round portrait,
                    a centered statement, then dense two-column lists.
   ───────────────────────────────────────────────────────────────────────── */
import Home from '../design-variants/HomeVariantC.astro';

const posts = (await getPosts()).slice(0, 5);

const papers = (await getCollection('papers', ({ data }) => data.visible))
  .map((entry) => entry.data)
  .filter((paper) => Boolean(paper.published_url))
  .sort((a, b) => Number(yearOf(b)) - Number(yearOf(a)))
  .slice(0, 4);
---

<Base title={site.title} description={site.description}>
  <Home posts={posts} papers={papers} />
</Base>
