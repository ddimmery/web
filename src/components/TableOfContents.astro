---
import BackToTop from './BackToTop.astro';
import type { MarkdownHeading } from 'astro';
import { nestHeadings, type TocItem } from '../lib/toc';

export type { TocItem };

interface Props {
  /** Rendered-markdown headings; nested automatically. Ignored if `items` is set. */
  headings?: MarkdownHeading[];
  /** A pre-built outline, for pages whose structure is not markdown headings. */
  items?: TocItem[];
  /** `sidebar` on wide screens, `mobile` renders a collapsible <details>. */
  variant: 'sidebar' | 'mobile';
  maxDepth?: number;
  /** Heading shown above the list. */
  label?: string;
  /** Extra class, e.g. `toc--outline` for section/year outlines. */
  class?: string;
}

const {
  headings = [],
  items,
  variant,
  maxDepth = 3,
  label = 'Contents',
  class: extraClass,
} = Astro.props;

const tree = items ?? nestHeadings(headings, maxDepth);
/** A one-item outline is not worth the furniture — see `hasOutline`. */
const show = tree.length > 1;
const classes = ['toc', `toc--${variant}`, extraClass].filter(Boolean).join(' ');
---

{
  show &&
    (variant === 'mobile' ? (
      <details class={classes}>
        <summary class="toc__label">{label}</summary>
        <ol>
          {tree.map((node) => (
            <li>
              <a href={`#${node.slug}`}>{node.text}</a>
              {node.children && node.children.length > 0 && (
                <ol>
                  {node.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class={classes} aria-label={label}>
        <BackToTop />
        <span class="toc__label">{label}</span>
        <ol>
          {tree.map((node) => (
            <li>
              <a href={`#${node.slug}`}>{node.text}</a>
              {node.children && node.children.length > 0 && (
                <ol>
                  {node.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    ))
}
