---
/**
 * The identity block that sits under the name on the landing page: the role
 * line, the short tagline, then the affiliation stack (lab / school / city),
 * one linked line each.
 *
 * Shared by every home-page layout variant so the facts live in one place.
 * Alignment is inherited (`text-align`), so a centered masthead can use it
 * unchanged. Styles are scoped, so they ship only when a variant renders it.
 *
 * Small caps: the heading face is URW Classico, whose woff2 carries no GSUB
 * table at all — no `smcp`, so `font-variant-caps` would only ever synthesize.
 * The role line is therefore set as letterspaced uppercase one step down,
 * which is the effect the owner was after.
 */
interface Props {
  /** Extra class on the wrapper. */
  class?: string;
}

const { class: extraClass } = Astro.props;

/** `href` is optional: the city is plain text, not a link. */
const affiliations: Array<{ text: string; href?: string }> = [
  { text: 'Data Science Lab', href: 'https://www.hertie-school.org/en/datasciencelab' },
  { text: 'Hertie School', href: 'https://www.hertie-school.org/en/' },
  { text: 'Berlin, DE' },
];
---

<div class:list={['identity', extraClass]}>
  <p class="identity__role">
    <a
      href="https://www.hertie-school.org/en/research/faculty-and-researchers/profile/person/dimmery"
      >Professor of Data Science for the Common Good</a
    >
  </p>
  <p class="identity__tagline">Social science methods</p>
  <ul class="identity__affiliation">
    {
      affiliations.map(({ text, href }) => (
        <li>{href ? <a href={href}>{text}</a> : text}</li>
      ))
    }
  </ul>
</div>

<style>
  .identity {
    margin-top: 0.5rem;
  }

  /* Letterspaced uppercase standing in for small caps — see the note above. */
  .identity__role {
    font-family: var(--font-heading-stack);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--accent);
    margin: 0;
    text-wrap: balance;
  }

  .identity__role a {
    color: inherit;
    text-decoration: none;
  }

  .identity__role a:hover {
    color: var(--accent);
  }

  .identity__tagline {
    font-family: var(--font-heading-stack);
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.35;
    color: var(--ink-muted);
    margin: 0.45rem 0 0;
  }

  .identity__affiliation {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    font-family: var(--font-heading-stack);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .identity__affiliation a {
    color: inherit;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.18em;
    /* WCAG 2.5.8 target size: pad the hit area vertically without moving
       the text (negative margin cancels the layout effect). */
    display: inline-block;
    padding-block: 0.35rem;
    margin-block: -0.35rem;
  }

  .identity__affiliation a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
</style>
