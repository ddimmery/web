---
/* =========================================================================
   BACK TO TOP — a single "↑ Top" entry pinned at the head of the sticky
   sidebar outline, set in the outline's own register, above the "Contents"
   label. No floating chrome: it appears only where the sidebar appears —
   ≥70rem, on post pages with an outline and on /research/ — so narrow
   viewports get nothing whatsoever, and it adds no new layer to the page.

   Rendered by `TableOfContents.astro` rather than `Base.astro` on purpose:
   this *is* an outline entry, and the outline is the only place it can live.
   It goes in the sidebar branch only (not the `mobile` <details> branch) —
   a "Top" link inside a collapsed accordion you must open first is worse
   than no link.

   REVEAL: where `scroll-state()` container queries are supported (Chromium),
   pure CSS shows the link at the exact moment the sticky outline pins
   (stuck: top) and hides it when it unpins — zero JS. Elsewhere a ~260 B
   feature-gated script measures the same thing geometrically (nav top at its
   sticky inset) on a rAF-throttled scroll listener and stamps [data-stuck].
   Both paths key off the outline actually floating, never a scroll distance.
   No JS + no scroll-state: the link stays hidden (it is an enhancement).

   SCROLL TARGET: `href="#"` (document top), not `#top`. The sidebar outline
   is `position: sticky`, which makes it a containing block for absolutely
   positioned descendants — so a `<span id="top">` emitted from inside it
   could not be pinned to the top of the page. `#` resolves to the top of the
   document directly and needs no anchor element at all.
   `html { scroll-behavior: smooth }` animates it and already yields to
   `prefers-reduced-motion`.
   ========================================================================= */
---

<a class="btt" href="#">
  <span class="btt__arrow" aria-hidden="true">&#8593;</span>
  <span>Top</span>
</a>

<script is:inline>
  /* Fallback stuck-detector for browsers without scroll-state container
     queries (Safari, Firefox). ~260 B. The CSS path wins where supported. */
  if (!CSS.supports('container-type: scroll-state')) {
    var n = document.currentScript.previousElementSibling.closest('.toc--sidebar');
    var a = document.querySelector('.btt');
    if (n && a) {
      var t = parseFloat(getComputedStyle(n).top) || 0, q = false;
      var f = function () {
        q = false;
        if (n.getBoundingClientRect().top <= t + 1) a.setAttribute('data-stuck', '');
        else a.removeAttribute('data-stuck');
      };
      addEventListener('scroll', function () { if (!q) { q = true; requestAnimationFrame(f); } }, { passive: true });
      f();
    }
  }
</script>

<style>
  /* The outline's entries are right-aligned (they hug the article's left edge),
     so this sits on the same right edge, above the label, separated by nothing
     more than space — a hairline here would compete with the label's own rule
     on the research outline. */
  .btt {
    display: block;
    margin-bottom: 0.7rem;
    font-family: var(--font-heading-stack);
    font-weight: 700;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .btt:hover,
  .btt:focus-visible {
    color: var(--accent);
  }

  .btt__arrow {
    /* The heading face has no arrow; borrow the body face's and drop the
       tracking so the glyph does not float away from its word. */
    font-family: var(--font-body-stack);
    letter-spacing: 0;
    margin-inline-end: 0.15em;
  }

  /* ---- reveal: only while the outline is actually pinned ---------------- */
  /* Hidden by default in every browser; `visibility` rather than `display` so
     the entry keeps its box and revealing it never shifts the outline. */
  .btt {
    opacity: 0;
    visibility: hidden;
    transition:
      color 120ms ease,
      opacity 160ms ease,
      visibility 0s 160ms;
  }

  .btt[data-stuck],
  .btt:focus-visible {
    opacity: 1;
    visibility: visible;
    transition:
      color 120ms ease,
      opacity 160ms ease;
  }

  /* Where scroll-state container queries exist (the parent nav is the
     container — see `.toc--sidebar` in blocks.css), pure CSS tracks the
     pinned state and the script above never runs. */
  @supports (container-type: scroll-state) {
    @container tocbar scroll-state(stuck: top) {
      .btt {
        opacity: 1;
        visibility: visible;
        transition:
          color 120ms ease,
          opacity 160ms ease;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btt {
      transition: none;
    }
  }
</style>
