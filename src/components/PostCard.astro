---
import { Image } from 'astro:assets';
import CategoryPills from './CategoryPills.astro';
import { formatDate, inlineMarkdown, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  activeCategory?: string;
  /**
   * Set on the first card in a list. That thumbnail is above the fold and is
   * the LCP element on /blog/ and the category pages, so it must not be
   * lazy-loaded — lazy images are only discovered after layout, which pushed
   * LCP out by ~2s. Every later card stays lazy.
   */
  eager?: boolean;
}

const { post, activeCategory, eager = false } = Astro.props;
const { title, description, date, categories, image } = post.data;
const href = postUrl(post);
---

<article class:list={['card', image && 'card--with-thumb']}>
  {
    image && (
      <a href={href} tabindex="-1" aria-hidden="true">
        <Image
          class="card__thumb"
          src={image}
          width={400}
          height={250}
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          fetchpriority={eager ? 'high' : undefined}
          alt=""
        />
      </a>
    )
  }
  <div class="card__body">
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="card__meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    {description && <p class="card__description" set:html={inlineMarkdown(description)} />}
    <CategoryPills categories={categories} active={activeCategory} />
  </div>
</article>
