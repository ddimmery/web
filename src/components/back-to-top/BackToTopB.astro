---
/* =========================================================================
   BACK TO TOP — VARIANT B · "bottom-right chip"   (PARKED, not active)

   The convention. A small rounded chip on the paper-raised surface with a
   hairline border, the shadow token and a single arrow. Nobody has to learn
   it; it is also the one option that adds a piece of floating furniture the
   site does not otherwise have.

   ACTIVATE — one line in `src/layouts/Base.astro`, immediately after
   `<Header />`:

       <BackToTopB />

   (plus the import:
       import BackToTopB from '../components/back-to-top/BackToTopB.astro';)

   REVEAL: CSS scroll-driven animation — `animation-timeline: scroll(root
   block)` over `animation-range: 70vh 100vh`, with `both` fill holding the
   hidden state before the range and the visible state after. Zero JavaScript.

   FALLBACK (no `animation-timeline: scroll()`): always visible. Correct for
   this variant — bottom-right is empty at every scroll position, so a chip
   that is simply always there is a slightly busier page, not a broken one.
   No script at all: 0 bytes of JS in every browser.

   SCROLL BEHAVIOUR: plain `#top` anchor; `html { scroll-behavior: smooth }`
   in global.css does the animation and already yields to
   `prefers-reduced-motion`.

   The `bottom` offset carries `env(safe-area-inset-bottom)` for iOS home-bar
   clearance, and sits high enough to stay clear of footnote preview popovers,
   which open *above* their marker in the prose column.
   ========================================================================= */
---

<span id="top" class="btt-anchor" aria-hidden="true"></span>

<a class="btt-b" href="#top" aria-label="Back to top">
  <span class="btt-b__arrow" aria-hidden="true">&#8593;</span>
</a>

<style>
  .btt-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .btt-b {
    position: fixed;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: calc(var(--space-m) + env(safe-area-inset-bottom));
    z-index: 20;

    display: grid;
    place-items: center;
    /* 2.6rem square: the same footprint as the social row's icon links, so the
       chip is already part of the site's vocabulary of round controls. */
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;

    color: var(--ink-soft);
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 2px 10px var(--shadow);
    text-decoration: none;
    transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease,
      box-shadow 120ms ease, translate 120ms ease;
  }

  /* Grows the touch target to ~44px without changing the drawn chip. */
  .btt-b::after {
    content: '';
    position: absolute;
    inset: -0.45rem;
  }

  .btt-b__arrow {
    font-family: var(--font-heading-stack);
    font-size: var(--step-0);
    line-height: 1;
    /* The arrow glyph rides high in the em box; nudge it onto the optical
       centre of the circle. */
    translate: 0 0.03em;
  }

  .btt-b:hover,
  .btt-b:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-wash);
    box-shadow: 0 3px 14px var(--shadow);
    translate: 0 -1px;
  }

  /* ---- reveal: scroll-driven, zero JS ---------------------------------- */
  /* Longhands, never the `animation` shorthand: the CSS minifier folds
     `animation-timeline` into the shorthand, which is not a valid component of
     it, and Chromium then drops the whole declaration — a reveal that silently
     never reveals. Keeping `animation-name` separate leaves nothing to fold. */
  @supports (animation-timeline: scroll()) {
    .btt-b {
      animation-name: btt-b-in;
      /* Required for a scroll-driven animation: the timeline is the duration. */
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 70vh 100vh;
    }

    @media (prefers-reduced-motion: reduce) {
      .btt-b {
        animation-name: btt-b-fade;
      }
    }
  }

  @keyframes btt-b-in {
    from {
      opacity: 0;
      visibility: hidden;
      translate: 0 0.5rem;
    }
    to {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }
  }

  /* Reduced-motion twin: same reveal, no travel. A separate name rather than a
     redefinition inside the media query — the minifier hoists nested
     `@keyframes` out, so a redefinition would win globally. */
  @keyframes btt-b-fade {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  /* No `@supports not` block: without scroll-driven animations the chip keeps
     its plain always-visible styling, which is the intended fallback. */

  @media (prefers-reduced-motion: reduce) {
    .btt-b {
      transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease;
    }

    .btt-b:hover,
    .btt-b:focus-visible {
      translate: 0 0;
    }
  }
</style>
