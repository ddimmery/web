---
/* =========================================================================
   BACK TO TOP — VARIANT A · "upper-left mark"   (PARKED, not active)

   The owner's instinct: the red DD mark pinned where the masthead mark sits,
   fading in once the header has scrolled away. Reads as the masthead's stamp
   staying behind rather than as a new piece of UI, and it reuses a position
   the eye already knows.

   ACTIVATE — one line in `src/layouts/Base.astro`, immediately after
   `<Header />`:

       <BackToTopA />

   (plus the import at the top of the frontmatter:
       import BackToTopA from '../components/back-to-top/BackToTopA.astro';)

   Placement after `<Header />` is deliberate: the component emits the `#top`
   anchor it links to, and that anchor must not be at the end of the body.
   It is absolutely positioned to the top of the initial containing block, so
   the exact include point is not load-bearing — but keeping it high in the
   body keeps the DOM honest.

   REVEAL: CSS scroll-driven animation. `animation-timeline: scroll(root
   block)` with `animation-range: 70vh 100vh` fades the mark in as the page
   passes roughly one screen of scroll, and `animation-fill-mode: both` holds
   it hidden before that range and visible after. Zero JavaScript in Chromium
   115+ and Safari 26+.

   FALLBACK (Firefox and anything else without `animation-timeline: scroll()`):
   "always visible" is wrong for *this* variant — at scroll 0 a fixed mark
   would sit on top of the real masthead mark and its tap target would cover
   the wordmark link. So this one variant carries a feature-gated shim: 216
   bytes that toggle a class off `scrollY`. Browsers with the CSS support never
   run the listener (the `CSS.supports` gate returns early), and a browser with
   neither the CSS nor JS simply never shows the control — the page is
   unharmed, since `Home`/`Cmd-Up` still exist.

   SCROLL BEHAVIOUR: a plain `#top` anchor. `html { scroll-behavior: smooth }`
   in global.css already animates it and is already switched off under
   `prefers-reduced-motion`, so there is nothing to gate here.
   ========================================================================= */
import Mark from '../Mark.astro';

/* Feature-gated fallback for engines without scroll-driven animations. 216 B
   as emitted. Kept as a string so Astro ships it verbatim and inline. */
const revealShim = `(function(){try{
if(CSS.supports('animation-timeline','scroll()'))return;
var r=document.documentElement;
addEventListener('scroll',function(){r.classList.toggle('btt-shown',scrollY>560)},{passive:true})
}catch(e){}})();`
  .split('\n')
  .join('');
---

{/* The scroll destination. Absolutely positioned to the top of the initial
    containing block so it is the document's top wherever this component is
    included. `scroll-padding-top` clamps harmlessly against 0. */}
<span id="top" class="btt-anchor" aria-hidden="true"></span>

{/* A full-width fixed strip that borrows `.wrap`'s own centring math, so the
    mark lands on exactly the same optical column as the masthead mark at every
    viewport width. The strip is click-through; only the link takes pointer
    events. */}
<div class="btt-a" aria-hidden="false">
  <div class="btt-a__rail wrap">
    <a class="btt-a__link" href="#top">
      <Mark class="btt-a__mark" />
      <span class="btt-a__label" aria-hidden="true">
        <span class="btt-a__arrow">&#8593;</span> Top
      </span>
      <span class="btt-a__sr">Back to top</span>
    </a>
  </div>
</div>

<script is:inline set:html={revealShim} />

<style>
  .btt-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Below 70rem this variant does not exist. Both page shells collapse to a
     single column there, so the left margin the mark lives in disappears and a
     fixed mark lands squarely on top of running text — verified at 1024 and
     390, where it sat over an author list and over a post's first figure. The
     margin is the whole idea, so the honest answer is to switch the variant off
     where there is no margin and pair it with variant B on narrow screens
     (see the README) rather than give it an opaque plate to sit on. */
  .btt-a {
    display: none;
  }

  @media (min-width: 70rem) {
    .btt-a {
      display: block;
      position: fixed;
      /* Measured, not guessed: at 1440 the masthead mark's box is 24px tall
         with its centre at y=31, so a 28px mark shares that centre line at
         top: 17px. The two marks sit on exactly one axis. */
      top: 1.05rem;
      inset-inline: 0;
      z-index: 20;
      pointer-events: none;
    }
  }

  .btt-a__rail {
    display: flex;
  }

  .btt-a__link {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    /* Generous tap target around a deliberately small glyph: the padding is
       part of the hit area, the negative margin keeps the mark itself on the
       masthead's column and baseline. */
    padding: 0.6rem 0.7rem 0.6rem 0.55rem;
    margin: -0.6rem 0 -0.6rem -0.55rem;
    border-radius: var(--radius);
    text-decoration: none;
    line-height: 0;
    transition: background-color 140ms ease;
  }

  /* The mark's hover state travels as custom properties set on the link, not as
     a descendant selector. Two reasons, both learned the hard way:

     1. `<Mark />` renders its own `<svg>`, and Astro does not stamp this
        component's `data-astro-cid-*` onto a child component's root element. A
        scoped `.btt-a__mark { … }` therefore compiles to
        `.btt-a__mark[data-astro-cid-…]` and silently matches nothing — the mark
        renders at its intrinsic 16px in the anchor's inherited link colour,
        which looks close enough to right to go unnoticed. Hence `:global`.
        (global.css styles the masthead and footer marks for the same reason.)
     2. `:global` in *descendant* position — `.btt-a__link:hover
        :global(.btt-a__mark)` — comes out of the minifier as a bare
        `.btt-a__mark`, so the hover state would apply permanently. Keeping every
        `:global` to a single compound selector avoids that entirely.

     The class and property names are variant-prefixed, so nothing else on the
     site can collide with them. */
  .btt-a__link {
    /* Quiet by default — the accent held back so the mark reads as a watermark
       beside the type rather than a button. */
    --btt-a-ink: color-mix(in srgb, var(--accent) 62%, transparent);
    --btt-a-lift: 1;
  }

  .btt-a__link:hover,
  .btt-a__link:focus-visible {
    --btt-a-ink: var(--accent);
    --btt-a-lift: 1.04;
  }

  :global(.btt-a__mark) {
    width: 28px;
    height: 28px;
    color: var(--btt-a-ink);
    scale: var(--btt-a-lift);
    transition: color 140ms ease, scale 140ms ease;
  }

  /* The label is the hover cue: a small caps word in the heading face, in the
     same register as the nav on the other end of the masthead. */
  .btt-a__label {
    font-family: var(--font-heading-stack);
    font-weight: 700;
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--accent);
    opacity: 0;
    translate: -0.35rem 0;
    transition: opacity 140ms ease, translate 140ms ease;
  }

  .btt-a__arrow {
    font-family: var(--font-body-stack);
    letter-spacing: 0;
  }

  .btt-a__link:hover .btt-a__label,
  .btt-a__link:focus-visible .btt-a__label {
    opacity: 1;
    translate: 0 0;
  }

  .btt-a__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- reveal: scroll-driven, zero JS ---------------------------------- */
  /* Longhands, never the `animation` shorthand. The CSS minifier happily folds
     `animation-timeline` *into* the shorthand — `animation: linear both
     btt-a-in scroll(root)` — and `animation-timeline` is not a component of
     that shorthand, so Chromium drops the whole declaration and the reveal
     silently stops working. Writing `animation-name` on its own keeps the
     minifier from having a shorthand to fold anything into. */
  @supports (animation-timeline: scroll()) {
    .btt-a {
      animation-name: btt-a-in;
      /* `auto` — required for a scroll-driven animation, where the timeline
         supplies the duration. */
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 70vh 100vh;
    }

    @media (prefers-reduced-motion: reduce) {
      .btt-a {
        animation-name: btt-a-fade;
      }
    }
  }

  @keyframes btt-a-in {
    from {
      opacity: 0;
      visibility: hidden;
      translate: 0 -0.4rem;
    }
    to {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }
  }

  /* Reduced-motion twin: same reveal, no travel. A separate name rather than a
     redefinition of `btt-a-in` inside the media query — the minifier hoists
     nested `@keyframes` out of their media query, so a redefinition would win
     globally and quietly delete the rise for everyone. */
  @keyframes btt-a-fade {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  /* ---- fallback: the shim's class, only in engines without the above --- */
  @supports not (animation-timeline: scroll()) {
    .btt-a {
      opacity: 0;
      visibility: hidden;
      transition: opacity 160ms ease, visibility 160ms ease;
    }

    :global(html.btt-shown) .btt-a {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btt-a__link,
    .btt-a__label {
      transition: none;
    }

    /* The colour change stays (it is the affordance); only the scale goes. */
    .btt-a__link:hover,
    .btt-a__link:focus-visible {
      --btt-a-lift: 1;
    }

    :global(.btt-a__mark) {
      transition: none;
    }
  }
</style>
