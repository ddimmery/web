---
/* =========================================================================
   BACK TO TOP — VARIANT D · "scroll-progress mark"   (PARKED, not active)

   The bold end of the spectrum: the DD mark bottom-right, seated inside a thin
   ring that fills with reading progress. Doubles as a "how much is left"
   indicator, which is the one thing a plain chip cannot do — and the one thing
   a page of running prose might actually want.

   ACTIVATE — one line in `src/layouts/Base.astro`, immediately after
   `<Header />`:

       <BackToTopD />

   (plus the import:
       import BackToTopD from '../components/back-to-top/BackToTopD.astro';)

   REVEAL + PROGRESS: two CSS scroll-driven animations on the same
   `scroll(root block)` timeline, no JavaScript at all.
     · the wrapper fades in over `animation-range: 70vh 100vh`;
     · the ring runs the full scroll range (`animation-range: normal`),
       animating a registered custom property (`@property --btt-d-progress`,
       `syntax: '<percentage>'`) that is the stop position inside a
       `conic-gradient`. Registering the property is what makes it
       interpolatable — an unregistered custom property would jump, not fill.

   FALLBACK: none, by design — `.btt-d` is `display: none` at base and only
   switched on inside `@supports (animation-timeline: scroll())`. A progress
   ring that cannot show progress is not worth shipping a degraded version of,
   so browsers without the feature (Firefox at time of writing) see nothing.
   0 bytes of JS everywhere.

   SCROLL BEHAVIOUR: plain `#top` anchor; `html { scroll-behavior: smooth }`
   handles the animation and already yields to `prefers-reduced-motion`.

   NOTE: the *ring* is progress, so it deliberately keeps filling under
   `prefers-reduced-motion` — it is information, not decoration. Only the
   entrance slide and the hover lift are switched off there.
   ========================================================================= */
import Mark from '../Mark.astro';
---

<span id="top" class="btt-anchor" aria-hidden="true"></span>

<a class="btt-d" href="#top" aria-label="Back to top">
  <span class="btt-d__ring" aria-hidden="true"></span>
  <Mark class="btt-d__mark" />
</a>

<style>
  /* Registered so it can be interpolated by the keyframes below. Global by
     nature (custom-property registrations are document-wide); the name is
     prefixed to keep it out of the token namespace in global.css. */
  @property --btt-d-progress {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  .btt-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .btt-d {
    /* Base state is "not shipped". The @supports block below is the only thing
       that turns this variant on. */
    display: none;

    position: fixed;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: calc(var(--space-m) + env(safe-area-inset-bottom));
    z-index: 20;

    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 2px 10px var(--shadow);
    transition: translate 120ms ease, box-shadow 120ms ease;
  }

  /* ~44px touch target around a 2.9rem control. */
  .btt-d::after {
    content: '';
    position: absolute;
    inset: -0.3rem;
  }

  /* The ring: a conic sweep of accent over the hairline track, with the middle
     punched out by an inset disc on ::before. Two elements would work too; a
     pseudo keeps the markup to one span. */
  .btt-d__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--accent) var(--btt-d-progress),
      var(--rule-strong) 0
    );
  }

  .btt-d__ring::before {
    content: '';
    position: absolute;
    /* Ring thickness. */
    inset: 2px;
    border-radius: 50%;
    background: var(--paper-raised);
  }

  /* The mark's hover state travels as custom properties set on the anchor, not
     as a descendant selector. Two reasons, both learned the hard way:

     1. `<Mark />` renders its own `<svg>`, and Astro does not stamp this
        component's `data-astro-cid-*` onto a child component's root element. A
        scoped `.btt-d__mark { … }` therefore compiles to
        `.btt-d__mark[data-astro-cid-…]` and silently matches nothing — the mark
        renders at its intrinsic 16px in the anchor's inherited link colour,
        which inside a ring reads as a rendering glitch. Hence `:global`.
        (global.css styles the masthead and footer marks for the same reason.)
     2. `:global` in *descendant* position — `.btt-d:hover
        :global(.btt-d__mark)` — comes out of the minifier as a bare
        `.btt-d__mark`, so the hover state would apply permanently. Keeping every
        `:global` to a single compound selector avoids that entirely.

     The class and property names are variant-prefixed, so nothing else on the
     site can collide with them. */
  .btt-d {
    --btt-d-ink: color-mix(in srgb, var(--accent) 72%, transparent);
    --btt-d-lift: 1;
  }

  .btt-d:hover,
  .btt-d:focus-visible {
    --btt-d-ink: var(--accent);
    --btt-d-lift: 1.06;
  }

  :global(.btt-d__mark) {
    position: relative;
    width: 20px;
    height: 20px;
    color: var(--btt-d-ink);
    scale: var(--btt-d-lift);
    transition: color 120ms ease, scale 120ms ease;
  }

  .btt-d:hover,
  .btt-d:focus-visible {
    translate: 0 -1px;
    box-shadow: 0 3px 14px var(--shadow);
  }

  /* ---- the whole variant, gated on scroll-driven animation support ------ */
  /* Longhands, never the `animation` shorthand: the CSS minifier folds
     `animation-timeline` into the shorthand, which is not a valid component of
     it, and Chromium then drops the whole declaration — both the reveal and the
     ring silently stop. Keeping `animation-name` separate leaves nothing to
     fold. */
  @supports (animation-timeline: scroll()) {
    .btt-d {
      display: grid;
      animation-name: btt-d-in;
      /* Required for a scroll-driven animation: the timeline is the duration. */
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 70vh 100vh;
    }

    .btt-d__ring {
      animation-name: btt-d-fill;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      /* `normal` = the whole scroll range, so the ring is true reading
         progress rather than progress-since-reveal. */
      animation-range: normal;
    }

    @media (prefers-reduced-motion: reduce) {
      /* Entrance loses its slide; the ring's fill is information, not
         decoration, so `btt-d-fill` is untouched. */
      .btt-d {
        animation-name: btt-d-fade;
      }
    }
  }

  @keyframes btt-d-in {
    from {
      opacity: 0;
      visibility: hidden;
      translate: 0 0.5rem;
    }
    to {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }
  }

  /* Reduced-motion twin of the entrance: same reveal, no travel. A separate
     name rather than a redefinition inside the media query — the minifier
     hoists nested `@keyframes` out, so a redefinition would win globally. */
  @keyframes btt-d-fade {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  @keyframes btt-d-fill {
    from {
      --btt-d-progress: 0%;
    }
    to {
      --btt-d-progress: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btt-d {
      transition: none;
    }

    :global(.btt-d__mark) {
      transition: none;
    }

    .btt-d:hover,
    .btt-d:focus-visible {
      translate: 0 0;
    }

    /* The colour change stays (it is the affordance); only the scale goes. */
    .btt-d:hover,
    .btt-d:focus-visible {
      --btt-d-lift: 1;
    }
  }
</style>
