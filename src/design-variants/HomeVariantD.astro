---
/* =========================================================================
   HOME VARIANT D — "full-bleed portrait rail"

   Variant C pushed harder: the identity rail becomes a tinted panel that
   bleeds to the left edge of the window and runs the full height of the page,
   with the portrait filling its width edge-to-edge under the masthead. Name,
   tagline and socials sit on the panel; everything else flows to its right.
   The panel's inner padding is computed so the portrait's left edge lines up
   with the site title above it at every width.

   To activate: change the `Home` import in src/pages/index.astro to this file.
   ========================================================================= */
import { Image } from 'astro:assets';
import HomeBio from '../components/HomeBio.astro';
import SocialRow from '../components/SocialRow.astro';
import { formatDate, postUrl } from '../lib/posts';
import { authorSegments, bestUrl, yearOf } from '../lib/papers';
import headshot from '../assets/headshot.webp';
import type { HomeProps } from './home-props';
import '../styles/home-variant-d.css';

const { posts, papers } = Astro.props as HomeProps;
---

<div class="d-page">
  <aside class="d-rail">
    <div class="d-rail__inner">
      {/* The rail is `clamp(19rem, 26vw, 27rem)` wide above 64rem and a 7rem
          thumbnail below it, so `sizes` mirrors that. The 600px source caps
          the ladder: a 27rem (432px) slot is covered at 1.4x. */}
      <Image
        class="d-rail__portrait"
        src={headshot}
        widths={[224, 320, 440, 600]}
        sizes="(min-width: 64rem) clamp(19rem, 26vw, 27rem), 7rem"
        width={600}
        height={800}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        alt="Drew Dimmery"
      />
      <div class="d-rail__id">
        <h1 class="d-rail__name">Drew Dimmery</h1>
        <p class="d-rail__tagline">
          Methods in causal inference, data science and social science
        </p>
      </div>
      {/* Outside the identity block so it can take a full-width row of its own
          on narrow screens, where seven icons will not fit beside the
          portrait. */}
      <SocialRow class="d-rail__socials" />
      <p class="d-rail__note">
        Professor of Data Science for the Common Good · Hertie School Data
        Science Lab · Berlin
      </p>
    </div>
  </aside>

  <div class="d-main">
    <div>
      <p class="d-lede">
        Causal inference, machine learning, and the design of better experiments.
      </p>
      <div class="d-bio">
        <HomeBio />
      </div>
    </div>

    <div class="d-recents">
      {
        posts.length > 0 && (
          <section>
            <div class="rule-heading">
              <h2 class="eyebrow">Recent posts</h2>
            </div>
            <ul class="teaser-list">
              {posts.map((post) => (
                <li>
                  <p class="teaser__title">
                    <a href={postUrl(post)}>{post.data.title}</a>
                  </p>
                  <p class="teaser__meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                  </p>
                </li>
              ))}
            </ul>
            <a class="more-link" href="/blog/">
              All posts
            </a>
          </section>
        )
      }

      {
        papers.length > 0 && (
          <section>
            <div class="rule-heading">
              <h2 class="eyebrow">Recent papers</h2>
            </div>
            <ul class="teaser-list">
              {papers.map((paper) => {
                const url = bestUrl(paper);
                return (
                  <li>
                    <p class="teaser__title">
                      {url ? <a href={url}>{paper.title}</a> : paper.title}
                    </p>
                    <p class="teaser__meta">
                      {authorSegments(paper.authors, { max: 3 }).map((part) =>
                        part.me ? <strong>{part.text}</strong> : part.text,
                      )}
                      {' · '}
                      {yearOf(paper)}
                    </p>
                  </li>
                );
              })}
            </ul>
            <a class="more-link" href="/research/">
              All research
            </a>
          </section>
        )
      }
    </div>
  </div>
</div>
