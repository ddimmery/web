---
/* =========================================================================
   HOME VARIANT E — "typographic index"

   Type carries the page. The name is set as two huge stacked Classico lines
   across the full shell, under a heavy rule; the bio and a small portrait sit
   in an asymmetric row beneath it; and everything recent is an index — big
   numerals in the margin, title, then date or venue on the right edge — run
   wall to wall with hairlines between rows. No cards, almost no imagery.

   To activate: change the `Home` import in src/pages/index.astro to this file.
   ========================================================================= */
import { Image } from 'astro:assets';
import HomeBio from '../components/HomeBio.astro';
import SocialRow from '../components/SocialRow.astro';
import { formatDate, postUrl } from '../lib/posts';
import { authorSegments, bestUrl, paperTitle, yearOf } from '../lib/papers';
import headshot from '../assets/headshot.webp';
import type { HomeProps } from './home-props';
import '../styles/home-variant-e.css';

const { posts, papers } = Astro.props as HomeProps;

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<div class="wrap e-page">
  <header class="e-mast">
    <h1 class="e-mast__name"><span>Drew</span><span>Dimmery</span></h1>
    <p class="e-mast__tagline">
      <span class="e-mast__kicker">
        Professor of Data Science for the Common Good · Data Science Lab · Hertie School ·
        Berlin, DE
      </span>
      Social science methods
    </p>
  </header>

  <div class="e-intro">
    <div class="e-intro__text">
      <p class="e-lede">
        Causal inference, machine learning, and the design of better
        experiments.
      </p>
      <div class="e-bio">
        <HomeBio />
      </div>
    </div>
    <div class="e-intro__aside">
      {/* Deliberately small — the type is the image here. 14rem = 224px, so the
          ladder stops well inside the 600px source. */}
      <Image
        class="e-portrait"
        src={headshot}
        widths={[176, 224, 320, 448]}
        sizes="(min-width: 52rem) 14rem, 9rem"
        width={600}
        height={800}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        alt="Drew Dimmery"
      />
      <SocialRow class="e-socials" />
    </div>
  </div>

  {
    posts.length > 0 && (
      <section class="e-section">
        <div class="e-section__head">
          <h2 class="eyebrow">Recent posts</h2>
          <a class="more-link" href="/blog/">
            All posts
          </a>
        </div>
        <ol class="e-index">
          {posts.map((post, i) => (
            <li>
              <span class="e-index__num" aria-hidden="true">
                {pad(i)}
              </span>
              <p class="e-index__title">
                <a href={postUrl(post)}>{post.data.title}</a>
              </p>
              <p class="e-index__meta">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    papers.length > 0 && (
      <section class="e-section">
        <div class="e-section__head">
          <h2 class="eyebrow">Recent papers</h2>
          <a class="more-link" href="/research/">
            All research
          </a>
        </div>
        <ol class="e-index">
          {papers.map((paper, i) => {
            const url = bestUrl(paper);
            return (
              <li>
                <span class="e-index__num" aria-hidden="true">
                  {pad(i)}
                </span>
                <div class="e-index__body">
                  <p class="e-index__title">
                    {url ? <a href={url}>{paperTitle(paper)}</a> : paperTitle(paper)}
                  </p>
                  <p class="e-index__byline">
                    {authorSegments(paper.authors, { max: 3 }).map((part) =>
                      part.me ? <strong>{part.text}</strong> : part.text,
                    )}
                  </p>
                </div>
                <p class="e-index__meta">
                  {yearOf(paper)}
                  {paper.venue && (
                    <span class="e-index__venue">{paper.venue}</span>
                  )}
                </p>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }
</div>
