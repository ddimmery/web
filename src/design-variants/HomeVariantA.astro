---
/* =========================================================================
   HOME VARIANT A — "refined current"  (ACTIVE)

   The layout the site already had, tightened up: bio on the left at a
   comfortable measure, a much larger portrait on the right that scales with
   the viewport, and the two recents columns below a full-width hairline.
   Quietest of the three; reads as a personal page rather than a masthead.
   ========================================================================= */
import { Image } from 'astro:assets';
import HomeBio from '../components/HomeBio.astro';
import SocialRow from '../components/SocialRow.astro';
import { formatDate, postUrl } from '../lib/posts';
import { authorSegments, bestUrl, paperTitle, yearOf } from '../lib/papers';
import headshot from '../assets/headshot.webp';
import type { HomeProps } from './home-props';

const { posts, papers } = Astro.props as HomeProps;
---

<div class="wrap">
  <section class="hero">
    <div class="hero__bio">
      <h1 class="hero__name">Drew Dimmery</h1>
      <p class="hero__tagline">
        Methods in causal inference, data science and social science
      </p>
      <div class="hero__prose">
        <HomeBio />
      </div>
      <SocialRow class="hero__socials" />
    </div>
    {/* The portrait column is fluid — `clamp(13rem, 22vw, 20rem)` above 46rem,
        11rem below it — so `sizes` mirrors that clamp and the browser picks a
        width. The source is 600×800, so the ladder stops at 600: a 20rem
        (320px) slot is covered at 1.9x and more would be an upscale. */}
    <Image
      class="hero__portrait"
      src={headshot}
      widths={[220, 320, 440, 600]}
      sizes="(min-width: 46rem) clamp(13rem, 22vw, 20rem), 11rem"
      width={600}
      height={800}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      alt="Drew Dimmery"
    />
  </section>

  <div class="section section--split">
    {
      posts.length > 0 && (
        <section>
          <div class="rule-heading">
            <h2 class="eyebrow">Recent posts</h2>
          </div>
          <ul class="teaser-list">
            {posts.map((post) => (
              <li>
                <p class="teaser__title">
                  <a href={postUrl(post)}>{post.data.title}</a>
                </p>
                <p class="teaser__meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </p>
              </li>
            ))}
          </ul>
          <a class="more-link" href="/blog/">All posts</a>
        </section>
      )
    }

    {
      papers.length > 0 && (
        <section>
          <div class="rule-heading">
            <h2 class="eyebrow">Recent papers</h2>
          </div>
          <ul class="teaser-list">
            {papers.map((paper) => {
              const url = bestUrl(paper);
              return (
                <li>
                  <p class="teaser__title">
                    {url ? <a href={url}>{paperTitle(paper)}</a> : paperTitle(paper)}
                  </p>
                  <p class="teaser__meta">
                    {authorSegments(paper.authors, { max: 3 }).map((part) =>
                      part.me ? <strong>{part.text}</strong> : part.text,
                    )}
                    {' · '}
                    {yearOf(paper)}
                    {paper.venue && (
                      <span>
                        {' · '}
                        <em>{paper.venue}</em>
                      </span>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
          <a class="more-link" href="/research/">All research</a>
        </section>
      )
    }
  </div>
</div>
