{
  "name": "ddimmery-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Drew Dimmery — ddimmery.com",
  "scripts": {
    "dev": "node scripts/vendor-mathjax.mjs && node scripts/subset-fonts.mjs && astro dev",
    "start": "npm run dev",
    "build": "node scripts/vendor-mathjax.mjs && node scripts/subset-fonts.mjs && astro build && node scripts/subset-fonts.mjs --audit",
    "preview": "astro preview",
    "check": "node scripts/subset-fonts.mjs && astro check",
    "sync-papers": "node scripts/sync-papers.mjs",
    "vendor-mathjax": "node scripts/vendor-mathjax.mjs",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "subset-fonts:audit": "node scripts/subset-fonts.mjs --audit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@mathjax/mathjax-euler-font-extension": "4.1.3",
    "@mathjax/mathjax-pagella-font": "4.1.3",
    "astro": "7.2.4",
    "hast-util-from-html-isomorphic": "2.0.0",
    "hast-util-to-text": "4.0.2",
    "mathjax": "4.1.3",
    "remark-math": "6.0.0",
    "sharp": "0.35.3",
    "unist-util-visit-parents": "6.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "subset-font": "2.5.0",
    "typescript": "6.0.3"
  }
}
